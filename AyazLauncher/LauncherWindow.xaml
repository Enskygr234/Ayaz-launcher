<Window x:Class="AyazLauncher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayaz Launcher"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Yazi}" UseLayoutRounding="True">

    <Grid x:Name="Kok" Margin="24" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Olcek" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="Kaydirma" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Gölge -->
        <Border CornerRadius="26" Background="#01000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#06142A"/>
            </Border.Effect>
        </Border>

        <!-- Buzlu cam -->
        <Border x:Name="Cam" CornerRadius="26" BorderThickness="1.2" ClipToBounds="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#AAE6F4FF" Offset="0"/>
                    <GradientStop Color="#33A9D4FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E61C3560" Offset="0"/>
                    <GradientStop Color="#EB12264A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Üstte ince parıltı -->
                <Border Height="40" VerticalAlignment="Top" CornerRadius="26,26,0,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#26FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Kar taneleri -->
                <Canvas x:Name="Kar" IsHitTestVisible="False" ClipToBounds="True"/>

                <StackPanel Margin="18,16,18,12">
                    <StackPanel x:Name="Yuvalar" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Ipucu" Margin="0,10,0,0" HorizontalAlignment="Center"
                               MaxWidth="500" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="#8FB3D9" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
